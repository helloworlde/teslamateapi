{
    "swagger": "2.0",
    "info": {
        "description": "REST API for TeslaMate data, including V1 resources and V2 objective analytics.",
        "title": "TeslaMateApi",
        "contact": {},
        "version": "2.0"
    },
    "basePath": "/api",
    "paths": {
        "/v2": {
            "get": {
                "description": "Returns the V2 analytics API version, scope, and currently advertised feature groups.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "V2 Summary"
                ],
                "summary": "V2 API capability information",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.V2InfoAPIResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/main.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/v2/cars/{CarID}/analytics/summary": {
            "get": {
                "description": "Returns objective driving, charging, parking, battery, update, and charging-cost summary metrics for one car in a selected period.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "V2 Summary"
                ],
                "summary": "V2 period summary analytics",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Car ID",
                        "name": "CarID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "enum": [
                            "day",
                            "week",
                            "month",
                            "quarter",
                            "year",
                            "custom",
                            "lifetime"
                        ],
                        "type": "string",
                        "description": "Aggregation period",
                        "name": "period",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Start datetime in RFC3339 format",
                        "name": "start",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End datetime in RFC3339 format",
                        "name": "end",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "IANA timezone",
                        "name": "timezone",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "none",
                            "previous_period",
                            "previous_year",
                            "lifetime_average"
                        ],
                        "type": "string",
                        "description": "Comparison mode",
                        "name": "compare",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.V2SummaryAPIResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.APIErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/main.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/main.APIErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.APIErrorBody": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "details": {},
                "message": {
                    "type": "string"
                }
            }
        },
        "main.APIErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/main.APIErrorBody"
                }
            }
        },
        "main.V2BatterySummary": {
            "type": "object",
            "properties": {
                "latest_battery_level_percent": {
                    "type": "integer"
                },
                "latest_ideal_range_km": {
                    "type": "number"
                },
                "latest_rated_range_km": {
                    "type": "number"
                }
            }
        },
        "main.V2ChargingSummary": {
            "type": "object",
            "properties": {
                "cost": {
                    "type": "number"
                },
                "duration_min": {
                    "type": "number"
                },
                "energy_added_kwh": {
                    "type": "number"
                },
                "energy_used_kwh": {
                    "type": "number"
                },
                "session_count": {
                    "type": "integer"
                }
            }
        },
        "main.V2ComparisonValue": {
            "type": "object",
            "properties": {
                "current": {
                    "type": "number"
                },
                "delta": {
                    "type": "number"
                },
                "delta_percent": {
                    "type": "number"
                },
                "previous": {
                    "type": "number"
                }
            }
        },
        "main.V2CostSummary": {
            "type": "object",
            "properties": {
                "charging_cost": {
                    "type": "number"
                },
                "cost_per_100km": {
                    "type": "number"
                },
                "cost_per_km": {
                    "type": "number"
                }
            }
        },
        "main.V2DataQuality": {
            "type": "object",
            "properties": {
                "complete": {
                    "type": "boolean"
                },
                "missing_fields": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "sample_count": {
                    "type": "integer"
                },
                "warnings": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "main.V2DrivingSummary": {
            "type": "object",
            "properties": {
                "avg_consumption_wh_per_km": {
                    "type": "number"
                },
                "distance_km": {
                    "type": "number"
                },
                "drive_count": {
                    "type": "integer"
                },
                "duration_min": {
                    "type": "number"
                },
                "max_speed_kmh": {
                    "type": "number"
                }
            }
        },
        "main.V2InfoAPIResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/main.V2InfoResponse"
                },
                "meta": {
                    "$ref": "#/definitions/main.V2Meta"
                }
            }
        },
        "main.V2InfoResponse": {
            "type": "object",
            "properties": {
                "features": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "scope": {
                    "type": "string",
                    "example": "analytics"
                },
                "version": {
                    "type": "string",
                    "example": "v2"
                }
            }
        },
        "main.V2Meta": {
            "type": "object",
            "properties": {
                "car_id": {
                    "type": "integer"
                },
                "compare": {
                    "type": "string"
                },
                "data_quality": {
                    "$ref": "#/definitions/main.V2DataQuality"
                },
                "end": {
                    "type": "string"
                },
                "generated_at": {
                    "type": "string"
                },
                "period": {
                    "type": "string"
                },
                "start": {
                    "type": "string"
                },
                "timezone": {
                    "type": "string"
                },
                "unit": {
                    "$ref": "#/definitions/main.V2Unit"
                }
            }
        },
        "main.V2ParkingSummary": {
            "type": "object",
            "properties": {
                "asleep_duration_min": {
                    "type": "number"
                },
                "offline_duration_min": {
                    "type": "number"
                },
                "online_duration_min": {
                    "type": "number"
                },
                "parked_duration_min": {
                    "type": "number"
                },
                "vampire_drain_percent": {
                    "type": "number"
                }
            }
        },
        "main.V2Summary": {
            "type": "object",
            "properties": {
                "battery": {
                    "$ref": "#/definitions/main.V2BatterySummary"
                },
                "charging": {
                    "$ref": "#/definitions/main.V2ChargingSummary"
                },
                "cost": {
                    "$ref": "#/definitions/main.V2CostSummary"
                },
                "driving": {
                    "$ref": "#/definitions/main.V2DrivingSummary"
                },
                "parking": {
                    "$ref": "#/definitions/main.V2ParkingSummary"
                },
                "updates": {
                    "$ref": "#/definitions/main.V2UpdateSummary"
                }
            }
        },
        "main.V2SummaryAPIResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/main.V2SummaryResponse"
                },
                "meta": {
                    "$ref": "#/definitions/main.V2Meta"
                }
            }
        },
        "main.V2SummaryResponse": {
            "type": "object",
            "properties": {
                "comparison": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/main.V2ComparisonValue"
                    }
                },
                "summary": {
                    "$ref": "#/definitions/main.V2Summary"
                }
            }
        },
        "main.V2Unit": {
            "type": "object",
            "properties": {
                "currency": {
                    "type": "string",
                    "example": "CNY"
                },
                "distance": {
                    "type": "string",
                    "example": "km"
                },
                "energy": {
                    "type": "string",
                    "example": "kWh"
                },
                "power": {
                    "type": "string",
                    "example": "kW"
                },
                "temperature": {
                    "type": "string",
                    "example": "C"
                }
            }
        },
        "main.V2UpdateSummary": {
            "type": "object",
            "properties": {
                "latest_version": {
                    "type": "string"
                },
                "update_count": {
                    "type": "integer"
                }
            }
        }
    }
}